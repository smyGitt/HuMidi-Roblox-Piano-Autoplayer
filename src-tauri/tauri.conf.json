{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HuMidi",
  "version": "2.1.6",
  "identifier": "com.humidi.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HuMidi",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/pedal_bilstm.safetensors"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBQTAyQkE5NDRBQkIwNDEKUldSQnNLdEVxU3VndXE1bXdQUU56YW80SmpVUFV2aFNKWFRaY05uajE1emFKWjhZUFlWd0FtUDQK",
      "endpoints": [
        "https://github.com/smyGitt/HuMidi-Roblox-Piano-Autoplayer/releases/download/build-v2.1.1/latest.json"
      ]
    }
  }
}
